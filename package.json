{
  "name": "node-stormlib",
  "version": "0.1.0-alpha.1",
  "description": "A library to process Blizzard game MPQ format archives.",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mpq": "bin/mpq.js"
  },
  "binary": {
    "module_name": "NodeStorm",
    "module_path": "prebuilds/{platform}-{arch}",
    "napi_versions": [
      8
    ]
  },
  "files": [
    "bin/",
    "index.d.ts",
    "index.js",
    "native.js",
    "read-worker.js",
    "scripts/",
    "main.cc",
    "CMakeLists.txt",
    "cmake/",
    "prebuilds/",
    "third_party/README.md",
    "third_party/StormLib/CMakeLists.txt",
    "third_party/StormLib/LICENSE",
    "third_party/StormLib/src/"
  ],
  "scripts": {
    "build": "cmake-js compile",
    "install": "node scripts/install.js",
    "test": "node --test test/*.test.js",
    "test:review": "node --test test/review-findings.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invoker-bot/node-stormlib.git"
  },
  "bugs": {
    "url": "https://github.com/invoker-bot/node-stormlib/issues"
  },
  "homepage": "https://github.com/invoker-bot/node-stormlib#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "Storm",
    "Blizzard",
    "Warcraft",
    "MPQ"
  ],
  "author": "Invoker Bot",
  "license": "MIT",
  "dependencies": {
    "bindings": "^1.5.0",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^4.3.0"
  }
}
